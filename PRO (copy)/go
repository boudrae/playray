<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loading...</title>

    <link rel="icon" href="https://sf-tb-sg.ibytedtos.com/obj/eden-sg/uhtyvueh7nulogpoguhm/tiktok-icon2.png">

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            text-align: center;
            overflow: hidden;
        }

        #logo {
            width: 220px;
            margin-bottom: 20px;
        }

        #text {
            font-size: 22px;
            color: #333;
            opacity: 0;
            animation: fade 1.2s forwards;
        }

        @keyframes fade {
            to { opacity: 1; }
        }

        .hint {
            font-size: 14px;
            margin-top: 10px;
            color: #666;
        }
    </style>
</head>

<body>

    <img id="logo"
        src="https://www9.0zz0.com/2024/04/06/13/548511907.gif"
        alt="loading">

    <div id="text">Please open in your browser for best experience</div>

    <script>
        function redirect(url) {
            const ua = navigator.userAgent.toLowerCase();
            const cleanUrl = url.replace(/^https?:\/\//, '');

            try {
                if (ua.includes("android")) {

                    // attempt intent (fast path)
                    window.location.href =
                        'intent://' +
                        cleanUrl +
                        '#Intent;scheme=https;package=com.android.chrome;end;';

                    // fallback only if intent fails
                    setTimeout(function () {
                        if (document.visibilityState === "visible") {
                            window.location.href = url;
                        }
                    }, 1500);

                } else {
                    window.location.href = url;
                }

            } catch (e) {
                window.location.href = url;
            }
        }

        setTimeout(function () {
            const url = "https://playray.online/";
            redirect(url);
        }, 2000);
    </script>

</body>
</html>
